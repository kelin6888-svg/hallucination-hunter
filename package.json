{
  "name": "hallucination-hunter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --import tsx --test tests/game.test.ts",
    "check": "npm run typecheck && npm test",
    "contract:compile": "hardhat compile --config hardhat.config.cjs",
    "contract:test": "hardhat test --config hardhat.config.cjs",
    "contract:deploy": "hardhat run scripts/deploy-contract.cjs --network monadTestnet --config hardhat.config.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.4",
    "viem": "^2.21.34",
    "wagmi": "^2.12.20",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.4",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "chai": "^4.5.0",
    "concurrently": "^9.0.1",
    "dotenv": "^18.0.10",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.15",
    "hardhat-gas-reporter": "^1.0.10",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.18.1",
    "solidity-coverage": "^0.8.17",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typechain": "^8.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
